# =============================================
# .htaccess - NovaTech Agencia Digital
# Compresion, caché, seguridad y redirecciones
# =============================================

# --- Compresion Gzip/Brotli ---
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE text/javascript
    AddOutputFilterByType DEFLATE text/xml
    AddOutputFilterByType DEFLATE text/plain
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE application/x-javascript
    AddOutputFilterByType DEFLATE application/json
    AddOutputFilterByType DEFLATE application/xml
    AddOutputFilterByType DEFLATE application/rss+xml
    AddOutputFilterByType DEFLATE application/atom+xml
    AddOutputFilterByType DEFLATE image/svg+xml
    AddOutputFilterByType DEFLATE font/ttf
    AddOutputFilterByType DEFLATE font/otf
    AddOutputFilterByType DEFLATE font/woff
    AddOutputFilterByType DEFLATE font/woff2
</IfModule>

# --- Caché del navegador ---
<IfModule mod_expires.c>
    ExpiresActive On

    # HTML - sin caché (contenido dinámico)
    ExpiresByType text/html "access plus 0 seconds"

    # CSS y JavaScript - 1 mes
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType text/javascript "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType application/x-javascript "access plus 1 month"

    # Imágenes - 1 año
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"

    # Fuentes - 1 año
    ExpiresByType font/ttf "access plus 1 year"
    ExpiresByType font/otf "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType application/font-woff "access plus 1 year"

    # JSON / XML - 1 día
    ExpiresByType application/json "access plus 1 day"
    ExpiresByType application/xml "access plus 1 day"
    ExpiresByType text/xml "access plus 1 day"

    # PDF - 1 mes
    ExpiresByType application/pdf "access plus 1 month"
</IfModule>

# --- Headers de caché HTTP ---
<IfModule mod_headers.c>
    # CSS y JS
    <FilesMatch "\.(css|js)$">
        Header set Cache-Control "public, max-age=2592000"
    </FilesMatch>

    # Imágenes
    <FilesMatch "\.(jpg|jpeg|png|gif|webp|svg|ico)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>

    # Fuentes
    <FilesMatch "\.(ttf|otf|woff|woff2)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>

    # HTML - no cachear
    <FilesMatch "\.html$">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
        Header set Pragma "no-cache"
        Header set Expires "0"
    </FilesMatch>
</IfModule>

# --- Seguridad ---
<IfModule mod_headers.c>
    # Prevenir clickjacking
    Header always set X-Frame-Options "SAMEORIGIN"

    # Prevenir MIME sniffing
    Header always set X-Content-Type-Options "nosniff"

    # Habilitar XSS Protection
    Header always set X-XSS-Protection "1; mode=block"

    # Referrer Policy
    Header always set Referrer-Policy "strict-origin-when-cross-origin"

    # Permissions Policy (restringir APIs innecesarias)
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"

    # Content Security Policy
    # JSON-LD inline scripts are pinned via sha256-...; no 'unsafe-inline' anywhere.
    # If you add more JSON-LD blocks, run scripts/.mavis-tmp-hashes.py and append the new sha256- here.
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'sha256-RWUDBS9/O3If5dYI0oot8yX6hDcYiNfS34P5ZRpKDQg=' 'sha256-9Q02Tim762toprnk+lY7VAmMpmjuJbE44wKkVABDffg='; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https://images.unsplash.com; connect-src 'self'; frame-ancestors 'self'; base-uri 'self'; form-action 'self' mailto:"
</IfModule>

# --- Redirecciones ---

# Forzar HTTPS (descomentar después de instalar certificado SSL)
# RewriteEngine On
# RewriteCond %{HTTPS} off
# RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Forzar www (opcional, descomentar si lo prefieres)
# RewriteCond %{HTTP_HOST} !^www\. [NC]
# RewriteRule ^(.*)$ https://www.%{HTTP_HOST}/$1 [L,R=301]

# --- Manejo de errores personalizado ---
ErrorDocument 404 /404.html

# --- Habilitar mod_rewrite ---
<IfModule mod_rewrite.c>
    RewriteEngine On
</IfModule>

# --- Proteger archivos sensibles ---
<FilesMatch "\.(env|log|ini|sh|sql)$">
    Require all denied
</FilesMatch>

# --- Prevenir acceso a .htaccess ---
<Files .htaccess>
    Require all denied
</Files>
